{
	"name": "obsidian-model-viewer",
	"version": "1.1.0",
	"description": "An Obsidian plugin to view and embed 3D models using Google’s <model-viewer> component.",
	"main": "main.js",
	"scripts": {
		"dev": "vite build --watch --mode development",
		"build": "npm run typecheck && vite build",
		"test:e2e": "npm run build && node --test tests/e2e/plugin.test.mjs",
		"version": "node version-bump.mjs && npm run changelog && git add manifest.json versions.json CHANGELOG.md",
		"changelog": "conventional-changelog -p angular -i CHANGELOG.md",
		"typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
		"lint": "oxlint",
		"format": "oxfmt",
		"format:check": "oxfmt --check"
	},
	"keywords": [],
	"author": "",
	"license": "0BSD",
	"devDependencies": {
		"@types/node": "22.20.5",
		"conventional-changelog": "8.1.3",
		"conventional-changelog-angular": "9.4.0",
		"obsidian": "1.14.4",
		"oxfmt": "0.78.0",
		"oxlint": "1.93.0",
		"oxlint-tsgolint": "7.0.2006",
		"typescript": "7.0.2",
		"vite": "8.3.7"
	},
	"dependencies": {
		"@google/model-viewer": "^4.0.0"
	},
	"type": "module",
	"engines": {
		"node": ">=22.12"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/janispritzkau/obsidian-model-viewer.git"
	}
}
